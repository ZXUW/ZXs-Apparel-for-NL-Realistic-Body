<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingCategoryDef>
    <defName>ZX_Apparel_Category</defName>
    <label>ZX Apparel</label>
    <parent>Apparel</parent>
  </ThingCategoryDef>

  <ThingDef Name="ZXApparelBase" Abstract="True">
    <thingClass>Apparel</thingClass>
    <category>Item</category>
    <selectable>True</selectable>
    <pathCost>10</pathCost>
    <useHitPoints>True</useHitPoints>
    <drawGUIOverlay>true</drawGUIOverlay>
    <altitudeLayer>Item</altitudeLayer>
    <alwaysHaulable>True</alwaysHaulable>
    <generateCommonality>0</generateCommonality>
    <generateAllowChance>0</generateAllowChance>
    <tradeability>Sellable</tradeability>
    <techLevel>Medieval</techLevel>
    <comps>
      <li Class="CompProperties_Forbiddable" />
      <li>
        <compClass>CompQuality</compClass>
      </li>
      <li>
        <compClass>CompColorable</compClass>
      </li>
    </comps>
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
      <onGroundRandomRotateAngle>10</onGroundRandomRotateAngle>
    </graphicData>
    <apparel>
      <canBeDesiredForIdeo>false</canBeDesiredForIdeo>
      <wearPerDay>0</wearPerDay>
      <gender>Female</gender>
      <shellRenderedBehindHead>true</shellRenderedBehindHead>
      <developmentalStageFilter>Child, Adult</developmentalStageFilter>
      <useWornGraphicMask>true</useWornGraphicMask>
      <tags>
        <li>Royal</li>
        <li>RoyalTier2</li>
        <li>RoyalTier5</li>
        <li>RoyalTier6</li>
        <li>RoyalTier7</li> 
      </tags>
    </apparel>
    <colorGenerator Class="ColorGenerator_Options">
			<options>
				<li>
					<weight>10</weight>
					<only>RGBA(1,1,1,1)</only>
				</li>
			</options>
		</colorGenerator>
    <tradeTags>
      <li>BasicClothing</li>
      <li>Clothing</li>
      <li>Armor</li>
    </tradeTags>
    <tickerType>Normal</tickerType>
    <thingCategories Inherit="false">
      <li>ZX_Apparel_Category</li>
    </thingCategories>
    <recipeMaker>
      <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
      <workSkill>Crafting</workSkill>
      <effectWorking>Tailor</effectWorking>
      <soundWorking>Recipe_Tailor</soundWorking>
      <recipeUsers>
        <li>ElectricTailoringBench</li>
        <li>HandTailoringBench</li>
      </recipeUsers>
      <displayPriority>20</displayPriority>
      <unfinishedThingDef>UnfinishedApparel</unfinishedThingDef>
      <defaultIngredientFilter>
        <categories>
          <li>Root</li>
        </categories>
      </defaultIngredientFilter>
    </recipeMaker>
  </ThingDef>

  <ThingDef ParentName="ZXApparelBase">
    <defName>Maiddress</defName>
    <label>Maid dress</label>
    <description>Maid dress</description>
    <graphicData>
      <texPath>Apparel/Maiddress</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutComplex</shaderType>
    </graphicData>
    <costList>
      <Cloth>80</Cloth>
    </costList>
    <statBases>
      <MaxHitPoints>300</MaxHitPoints>
      <WorkToMake>160</WorkToMake>
      <Mass>1.5</Mass>
      <ArmorRating_Sharp>0.025</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.05</ArmorRating_Blunt>
      <ArmorRating_Heat>0.05</ArmorRating_Heat>
      <Insulation_Cold>24</Insulation_Cold>
      <Insulation_Heat>8</Insulation_Heat>
      <Flammability>-1</Flammability>
      <EquipDelay>1</EquipDelay>
      <Beauty>16</Beauty>
    </statBases>
    <apparel>
      <wornGraphicPath>Apparel/Maiddress</wornGraphicPath>
      <layers>
        <li>LA_Layer_Outer</li>
      </layers>
      <bodyPartGroups>
        <li>Neck</li>
        <li>Torso</li>
        <li>Shoulders</li>
        <li>Arms</li>
        <li>Legs</li>
      </bodyPartGroups>
    </apparel>
  </ThingDef>

